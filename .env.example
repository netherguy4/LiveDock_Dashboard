# UI login credentials (form-based).
LOGIN=admin
PASSWORD=replace-me

# HMAC secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me

# Server-side storage.
# Vercel Marketplace Postgres providers usually inject DATABASE_URL or POSTGRES_URL.
# Supabase integrations may inject DATABASE_POSTGRES_URL.
# When neither is present, LiveDock uses SQLite.
# DATABASE_URL=
# POSTGRES_URL=
# DATABASE_POSTGRES_URL=
# DATABASE_POSTGRES_PRISMA_URL=
# DATABASE_POSTGRES_URL_NON_POOLING=

# Optional SQLite file path for self-hosted/node-server deployments.
# SQLITE_PATH=.data/livedock.sqlite

# Nitro deploy preset (vercel by default).
# NITRO_PRESET=node-server
