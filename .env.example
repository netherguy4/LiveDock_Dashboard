# Backend (Go API) URL — server-side only. The browser never sees this.
BACKEND_URL=https://api.nether.pp.ua

# Bearer token shared with the Go backend. Server-side only.
API_TOKEN=replace-me

# UI login credentials (form-based).
LOGIN=admin
PASSWORD=replace-me

# HMAC secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me

# Default polling interval (ms). Public — exposed to the browser.
NUXT_PUBLIC_POLL_INTERVAL=2000

# Nitro deploy preset (vercel by default).
# NITRO_PRESET=node-server
