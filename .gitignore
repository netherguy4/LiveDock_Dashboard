# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Yarn 4 (nodeLinker: node-modules) ───────────────────────────────────────
# .yarn/releases  → keep (Yarn binary, should be committed)
# .yarn/plugins   → keep (installed plugins)
# yarn.lock       → keep (lockfile must be committed)
.yarn/cache
.yarn/install-state.gz
.pnp.cjs
.pnp.loader.mjs

# ── Nuxt build artefacts ─────────────────────────────────────────────────────
.nuxt/
.output/
.nitro/
.cache/
dist/

# ── Deploy adapters ──────────────────────────────────────────────────────────
.vercel/
.netlify/

# ── Environment — secrets must NOT be committed ──────────────────────────────
.env
.env.local
.env.*.local

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.data/

# ── Editor / tooling ─────────────────────────────────────────────────────────
.idea/
.vscode/
.claude/
docs/
test-results/
*.swp
*.swo

# ── TypeScript / Vite ────────────────────────────────────────────────────────
*.tsbuildinfo
